document          = { line-break | section-meta | (chord-line, line-end) } ;
section-meta      = "@", section-meta-key, "=", section-meta-value, line-end ;
section-meta-key  = "section" | "repeat" | "same" ;

chord-line        = bar, { "-", bar } ;
bar               = chord-info, { ",", chord-info } ;
chord-info        = chord-meta*, chord-expression, denominator? ;
chord-meta        = "[", "key", "=", key, "]" ;

chord-expression  = chord | "?" | "_" | "%" ;
chord             = base, accidental?, chord-type?, extensions? ;
base              = "A" | "B" | "C" | "D" | "E" | "F" | "G" ;
accidental        = "#" | "b" ;
chord-type        = "m" | "M" | "aug" | "dim" ;
extensions        = "(", extension, { ",", extension }, ")" ;
extension         = "1" | "2" | "3" | "b3" | "4" | "b5" | "5" | "#5" | "b6" | "6" | "7" | "b9" | "9" | "#9" | "b11" | "11" | "#11" | "b13" | "13" | "#13" | "M7" | "M9" | "M11" | "M13" | "add9" | "add11" | "add13" | "sus2" | "sus4" | "o" ;
denominator       = "/", denominator-text ;

line-end          = line-break | end-of-input ;
line-break        = "\r\n" | "\n" | "\r" ;

(*
  Space and tab may surround structural tokens, but may not split a text atom.
  The document is a sequence of lines; sections are assembled by the rules below.
  A single line break inside a section is preserved as ChordBlock::Br.
  Between chord lines, two or more consecutive line breaks remain in the same
  section and are preserved as two ChordBlock::Br values (one blank line).
  Blank lines do not reset section metadata or the previous-chord reference.
  Section metadata after chord lines starts a new section even with only one
  intervening line break. A document may contain any number of sections.
  In chord-based sections, metadata remains attached to the following chord lines even when
  blank lines occur between the metadata and the first chord line.
  Leading/trailing line breaks and blank lines before the first chord line
  are omitted; section boundaries are formatted with one blank line.
  Same metadata stores a named-section reference without resolving or expanding
  it. A reference-only section is complete: subsequent section or same metadata
  starts a new section, while repeat metadata still belongs to the reference.
  A section with same metadata must not contain chord lines (SMIV-4).
  This is a canonical AST serialization format; extensions require parentheses.
  For compatibility, the parser also accepts one trailing comma after a bar's
  last chord-info (including before a dash, line break, or end of input).
  The formatter omits that comma; extension lists do not allow trailing commas.
  Conventional chord-symbol aliases are not accepted as chord heads.
  The concrete values of key, section-meta-value, and
  denominator-text are defined by semantic validation.
*)
